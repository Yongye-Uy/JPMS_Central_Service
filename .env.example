APP_NAME="JPMS Central-Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://central-service.internal

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Dedicated PostgreSQL server (its own server per the deployment plan).
DB_CONNECTION=pgsql
DB_HOST=pgsql.internal
DB_PORT=5432
DB_DATABASE=jpms
DB_USERNAME=jpms
DB_PASSWORD=

# Dedicated MongoDB server (audit_log collection only).
MONGODB_URI=mongodb://mongodb.internal:27017
MONGODB_DATABASE=jpms_audit

# Shared secret API must present in X-Internal-Token to call /internal/v1/*.
INTERNAL_SHARED_SECRET=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Local disk now; swap to s3 (R2-compatible) once configured — nothing else
# in the codebase needs to change.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=jpms_central

# Dedicated Redis server.
REDIS_CLIENT=phpredis
REDIS_HOST=redis.internal
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cloudflare R2 (S3-compatible) ---
# To go live: set FILESYSTEM_DISK=s3 above and fill these in. Nothing else
# in the codebase needs to change.
# AWS_ENDPOINT = your R2 account endpoint (https://<account_id>.r2.cloudflarestorage.com)
# AWS_URL      = public bucket URL, if using a public bucket/custom domain
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
